{
  "name": "@repo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "worker:dev": "tsx watch --env-file=../../.env src/worker.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "start": "node --env-file=../../.env dist/server.js",
    "test": "tsx --test test/notification.worker.test.ts",
    "test:unit": "tsx --test test/notification.worker.test.ts",
    "test:integration": "sh -c 'if [ -f ../../.env ]; then exec tsx --env-file=../../.env --test test/bookings.concurrency.test.ts test/bookings.crud.test.ts; else exec tsx --test test/bookings.concurrency.test.ts test/bookings.crud.test.ts; fi'"
  },
  "dependencies": {
    "@repo/database": "*",
    "@repo/shared": "*",
    "bullmq": "^6.0.11",
    "fastify": "^5.2.1",
    "ioredis": "^6.0.0",
    "nodemailer": "^9.0.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^8.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
