    "bullmq": "^6.0.11",
    "fastify": "^5.2.1",
    "ioredis": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
