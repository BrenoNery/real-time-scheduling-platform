# Real-Time Scheduling Platform — local development environment
#
# Copy to .env and adjust values to match your setup:
#   cp .env.example .env
#
# PostgreSQL and Redis are expected via DBngin by default. The Docker Compose
# `full` profile is optional for CI or contributors who prefer all-container setup:
#   docker compose -f docker/docker-compose.yml --profile full up -d

# --- Database (DBngin by default) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/scheduling_platform"

# --- Redis (DBngin by default) ---
REDIS_URL="redis://localhost:6379"

# --- Email / SMTP (Mailpit via Docker) ---
# Start Mailpit: docker compose -f docker/docker-compose.yml up -d mailpit
# Web UI: http://localhost:8025
SMTP_HOST="localhost"
SMTP_PORT="1025"

# --- API ---
PORT="3333"
