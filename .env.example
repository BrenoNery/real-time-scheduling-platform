# Real-Time Scheduling Platform — local development environment
#
# Copy to .env and adjust values to match your setup:
#   cp .env.example .env
#
# PostgreSQL and Redis are expected via DBngin by default. The Docker Compose
# `full` profile is optional for CI or contributors who prefer all-container setup:
#   docker compose -f docker/docker-compose.yml --profile full up -d

# --- Database (DBngin by default) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/scheduling_platform"

# --- Redis (DBngin by default) ---
REDIS_URL="redis://localhost:6379"

# --- Email / SMTP (Mailpit via Docker) ---
# Start Mailpit: docker compose -f docker/docker-compose.yml up -d mailpit
# Web UI: http://localhost:8025
SMTP_HOST="localhost"
SMTP_PORT="1025"

# --- API ---
PORT="3333"
API_URL="http://localhost:3333"
# Signs login tokens (POST /auth/login, /auth/register). Required: the API refuses to start
# without it, and the web app uses the same value to verify the session cookie.
# Use a long random value outside local dev, e.g. `openssl rand -base64 32`.
JWT_SECRET="local-dev-jwt-secret-change-me"
# Rate limit on POST /bookings, counted per authenticated client (in memory, per API process).
# Over the limit the API answers 429 RATE_LIMITED. MAX is requests per client per WINDOW;
# WINDOW is in milliseconds. Both must be positive integers or the API refuses to start.
# Defaults when unset: 10 requests per 60000 ms (1 minute).
BOOKING_RATE_LIMIT_MAX="10"
BOOKING_RATE_LIMIT_WINDOW="60000"
