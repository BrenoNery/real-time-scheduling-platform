generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PROVIDER
  CLIENT
  ADMIN
}

enum SlotStatus {
  AVAILABLE
  BOOKED
  BLOCKED
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum NotificationType {
  CONFIRMATION
  REMINDER
  CANCELLATION
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  name      String
  role      Role
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  services Service[]
  bookings Booking[]

  @@map("users")
}

model Service {
  id              String   @id @default(uuid()) @db.Uuid
  providerId      String   @map("provider_id") @db.Uuid
  name            String
  description     String
  // Must be > 0. Enforced by services_duration_minutes_positive CHECK in SQL —
  // Prisma cannot model CHECK constraints here the way we need them in migrations.
  durationMinutes Int      @map("duration_minutes")
  createdAt       DateTime @default(now()) @map("created_at")

  provider  User       @relation(fields: [providerId], references: [id])
  timeSlots TimeSlot[]

  @@map("services")
}

model TimeSlot {
  id        String     @id @default(uuid()) @db.Uuid
  serviceId String     @map("service_id") @db.Uuid
  startsAt  DateTime   @map("starts_at")
  endsAt    DateTime   @map("ends_at")
  status    SlotStatus
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  service  Service   @relation(fields: [serviceId], references: [id])
  bookings Booking[]

  // ends_at > starts_at (time_slots_ends_after_starts) and no overlapping ranges
  // per service (time_slots_no_overlap EXCLUDE USING gist) live in SQL — Prisma
  // cannot model CHECK/EXCLUDE.
  @@index([serviceId, startsAt])
  @@map("time_slots")
}

model Booking {
  id          String        @id @default(uuid()) @db.Uuid
  // Not @unique: cancelled rows must not occupy the slot. At most one
  // non-cancelled booking per slot is enforced by the partial unique index
  // bookings_slot_id_active_key (WHERE status <> 'CANCELLED') in SQL —
  // Prisma cannot model a WHERE clause on @@unique.
  slotId      String        @map("slot_id") @db.Uuid
  clientId    String        @map("client_id") @db.Uuid
  status      BookingStatus
  bookedAt    DateTime      @default(now()) @map("booked_at")
  cancelledAt DateTime?     @map("cancelled_at")

  slot             TimeSlot          @relation(fields: [slotId], references: [id])
  client           User              @relation(fields: [clientId], references: [id])
  notificationJobs NotificationJob[]

  @@map("bookings")
}

model NotificationJob {
  id        String             @id @default(uuid()) @db.Uuid
  bookingId String             @map("booking_id") @db.Uuid
  type      NotificationType
  status    NotificationStatus
  payload   Json
  createdAt DateTime           @default(now()) @map("created_at")
  sentAt    DateTime?          @map("sent_at")

  booking Booking @relation(fields: [bookingId], references: [id])

  @@map("notification_jobs")
}
